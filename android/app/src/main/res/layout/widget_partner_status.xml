<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:gravity="center">

    <!-- Top Row: Avatar & Partner Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/widget_partner_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/avatar_irina"
            android:scaleType="centerCrop"
            android:contentDescription="Аватар партнера" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_partner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ИРИНА"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_btn_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄"
            android:textSize="16sp"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Bottom Row: 3 Life Spheres (Icons, Values, Direction Arrows) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Секс Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_stat_box"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_heart"
                android:contentDescription="Секс" />

            <TextView
                android:id="@+id/widget_val_sex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#2ECC71"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_dir_sex"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/dir_equal"
                android:layout_marginTop="2dp"
                android:contentDescription="Динамика Секс" />
        </LinearLayout>

        <!-- Общение Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_stat_box"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_bubble"
                android:contentDescription="Общение" />

            <TextView
                android:id="@+id/widget_val_comm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#2ECC71"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_dir_comm"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/dir_equal"
                android:layout_marginTop="2dp"
                android:contentDescription="Динамика Общение" />
        </LinearLayout>

        <!-- Быт Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_stat_box"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_home"
                android:contentDescription="Быт" />

            <TextView
                android:id="@+id/widget_val_dom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#2ECC71"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_dir_dom"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/dir_equal"
                android:layout_marginTop="2dp"
                android:contentDescription="Динамика Быт" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
